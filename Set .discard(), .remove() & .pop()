n = int(input())
s = set(map(int, input().split()))
N = int(input())

for _ in range(N):
    command_line = input().split()
    command = command_line[0]

    if command == "pop":
        s.pop()
    else:
        value = int(command_line[1])
        if command == "remove":
            try:
                s.remove(value)
            except KeyError:
                # ignore if element not found
                pass
        elif command == "discard":
            s.discard(value)

print(sum(s))
