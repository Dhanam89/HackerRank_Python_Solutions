def is_valid_uid(uid):
    if len(uid) != 10:
        return False
    if not uid.isalnum():
        return False
    if len(set(uid)) != 10:  # Check no repetition
        return False
    
    uppercase_count = sum(1 for c in uid if c.isupper())
    digit_count = sum(1 for c in uid if c.isdigit())
    
    if uppercase_count < 2:
        return False
    if digit_count < 3:
        return False
    
    return True


if __name__ == '__main__':
    n = int(input())
    for _ in range(n):
        uid = input().strip()
        print("Valid" if is_valid_uid(uid) else "Invalid")
