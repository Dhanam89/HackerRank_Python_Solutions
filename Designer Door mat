# Read input
n, m = map(int, input().split())

# Top part of the mat
for i in range(1, n, 2):
    pattern = (".|." * i).center(m, "-")
    print(pattern)

# Middle of the mat
print("WELCOME".center(m, "-"))

# Bottom part of the mat
for i in range(n - 2, 0, -2):
    pattern = (".|." * i).center(m, "-")
    print(pattern)
